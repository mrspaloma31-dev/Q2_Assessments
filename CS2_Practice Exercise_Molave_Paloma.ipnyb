      "source": [
        "# 1. Personal Savings Tracker Scenario"
      ],
      "metadata": {
        "id": "zMgCoZ_fE9cI"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def main():\n",
        "    target = float(input(\"Enter savings target: ₱\"))\n",
        "    total_savings = 0.0\n",
        "\n",
        "    while True:\n",
        "        deposit = float(input(\"Enter deposit (0 to finish): ₱\"))\n",
        "        if deposit == 0:\n",
        "            break\n",
        "\n",
        "        total_savings += deposit\n",
        "        print(f\"Updated savings: ₱{total_savings:.2f}\")\n",
        "\n",
        "    print(f\"\\nTotal savings: ₱{total_savings:.2f}\")\n",
        "\n",
        "    if total_savings >= target:\n",
        "        print(\"Goal reached!\")\n",
        "    else:\n",
        "        print(\"Keep saving!\")\n",
        "        print(f\"Remaining amount needed: ₱{target - total_savings:.2f}\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ],
      "metadata": {
        "id": "NgUIp2GJFGdw",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
